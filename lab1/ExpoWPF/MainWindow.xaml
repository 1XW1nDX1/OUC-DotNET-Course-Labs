        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExpoWPF"
        mc:Ignorable="d"
        Title="25030021018科创展提示工具" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="179*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="B1" Content="生成提示" HorizontalAlignment="Left" VerticalAlignment="Center" Click="B1_Click" Grid.Column="1" Margin="290,0,0,0"/>
        <Label x:Name="result" Content="生成结果" HorizontalAlignment="Left" Margin="287,288,0,0" VerticalAlignment="Top" Grid.Column="1"/>
